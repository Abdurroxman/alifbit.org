# Production secrets: configure with `npx wrangler secret put NAME`.
# Never commit real values. Local development uses ignored .dev.vars.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
IP_HASH_SECRET=
# Optional notification delivery to your own Telegram bot and chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# pay.alifbit.org: to'lov markazi admin panelidagi «alifbit» API mijozining tokeni va callback siri.
# PAY_API_URL wrangler.jsonc dagi oddiy o'zgaruvchi.
PAY_API_TOKEN=
PAY_CALLBACK_SECRET=
