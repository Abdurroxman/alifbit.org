{
  "name": "alifbit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787 --infer-origin-from-routes false",
    "db:local": "wrangler d1 migrations apply alifbit-db --local",
    "db:remote": "wrangler d1 migrations apply alifbit-db --remote",
    "deploy": "wrangler deploy",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "node": "^22.23.5",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wrangler": "^4.161.0"
  }
}
